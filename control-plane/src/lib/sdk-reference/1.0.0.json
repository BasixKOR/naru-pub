              "value": "Top-level user fields, combined with AND."
            }
          ]
        }
      ],
      "throws": [],
      "signature": "type Filter = Record<\n  string,\n  | string\n  | number\n  | boolean\n  | null\n  | {\n      gt?: string | number;\n      gte?: string | number;\n      lt?: string | number;\n      lte?: string | number;\n    }\n>"
    },
    {
      "name": "Json",
      "kind": "type",
      "summary": [],
      "throws": [],
      "signature": "type Json =\n  | null\n  | boolean\n  | number\n  | string\n  | Json[]\n  | { [key: string]: Json }"
    },
    {
      "name": "NaruErrorCode",
      "kind": "type",
      "summary": [
        {
          "type": "paragraph",
          "spans": [
            {
              "type": "text",
              "value": "Why an operation failed. The list is closed for v1: a code a later server adds reaches this version as the nearest code here."
            }
          ]
        }
      ],
      "throws": [],
      "signature": "type NaruErrorCode =\n  | \"CONFLICT\"\n  | \"QUOTA_EXCEEDED\"\n  | \"AUTH_REQUIRED\"\n  | \"ACCESS_DENIED\"\n  | \"NOT_FOUND\"\n  | \"RATE_LIMITED\"\n  | \"INVALID_REQUEST\"\n  | \"UNAVAILABLE\""
    },
    {
      "name": "Revision",
      "kind": "type",
      "summary": [
        {
          "type": "paragraph",
          "spans": [
            {
              "type": "text",
              "value": "An opaque concurrency token. Store and return it unchanged."
            }
          ]
        }
      ],
      "throws": [],
      "signature": "type Revision = string & { [revisionBrand]: true }"
    },
    {
      "name": "Sort",
      "kind": "type",
      "summary": [
        {
          "type": "paragraph",
          "spans": [
            {
              "type": "text",
              "value": "One or two keys: a user field by name, or document metadata."
            }
          ]
        }
      ],
      "throws": [],
      "signature": "type Sort =\n  | readonly [\n      readonly [\n        string | { metadata: \"id\" | \"createdAt\" | \"updatedAt\" },\n        \"asc\" | \"desc\",\n      ],\n    ]\n  | readonly [\n      readonly [\n        string | { metadata: \"id\" | \"createdAt\" | \"updatedAt\" },\n        \"asc\" | \"desc\",\n      ],\n      readonly [\n        string | { metadata: \"id\" | \"createdAt\" | \"updatedAt\" },\n        \"asc\" | \"desc\",\n      ],\n    ]"
    },
    {
      "name": "WriteCondition",
      "kind": "type",
      "summary": [
        {
          "type": "paragraph",
          "spans": [
            {
              "type": "text",
              "value": "Write only at this revision, or only if the document does not exist yet."
            }
          ]
        }
      ],
      "throws": [],
      "signature": "type WriteCondition = { revision: Revision } | { absent: true }"
    }
